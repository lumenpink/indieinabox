# Nome do domínio onde o indieinabox será servido (usado também por Gemini e Gopher)
APP_DOMAIN=localhost

# Habilitar HTTPS automático via Caddy/FrankenPHP?
# Quando configurado para um domínio real, o Caddy obtém certificados via Let's Encrypt automaticamente.
ENABLE_SSL=false

# Portas de exposição (caso precise colocar atrás de um proxy reverso ou alterar a porta padrão)
HTTP_PORT=80
HTTPS_PORT=443
GEMINI_PORT=1965
GOPHER_PORT=70
