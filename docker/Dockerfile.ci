# CI image — PHP 8.4 + Node.js 22 LTS + Xdebug + Composer
# NOT the production image (see docker/Dockerfile for that — uses FrankenPHP).
#
# Node.js 22 LTS is required by the Forgejo runner (act) to execute
# JavaScript-based actions (checkout, cache, upload-artifact, etc.)
# when a container: is specified in the workflow job.
#
# Build:
#   docker build -f docker/Dockerfile.ci -t indieinabox-ci:latest .
#
# Rebuilt automatically by .forgejo/workflows/docker-ci-image.yml
# when this file changes on main.

FROM php:8.4-cli

# All required PHP extensions are already in php:8.4-cli:
# curl, fileinfo, json, mbstring, pdo_sqlite, sqlite3, OPcache

# Install mlocati/docker-php-extension-installer helper for reliable extension builds
COPY --from=mlocati/php-extension-installer /usr/bin/install-php-extensions /usr/local/bin/

# System tools + Node.js 22 LTS
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        unzip \
        curl \
        ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install required PHP extensions for image generation & testing: GD, zip, exif
RUN install-php-extensions gd zip exif

# Xdebug — installed but OFF by default.
# Enable per-step with: env: XDEBUG_MODE: coverage
RUN pecl install xdebug \
    && docker-php-ext-enable xdebug \
    && echo "xdebug.mode=off" >> /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini \
    && rm -rf /tmp/pear

# Composer 2 (copied from official image — no installer script needed)
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /workspace
