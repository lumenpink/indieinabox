<?xml version="1.0" encoding="UTF-8"?>
<psalm
    errorLevel="4"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="app" />
        <directory name="bootstrap" />
        <file name="build.php" />
        <ignoreFiles>
            <directory name="vendor" />
	    <file name="app/Support/Yaml.php" />
            <file name="app/functions/beautify-html.php" />
	    <file name="app/functions/HtmlMinifier.php" />
        </ignoreFiles>
    </projectFiles>



    <!--
        Fontes de entrada contaminada (tainted):
        - Nomes de arquivos vindos de paths externos (content/)
        - Dados brutos lidos de arquivos .md via file_get_contents
    -->
    <taintAnalysis>
        <!-- file_get_contents é uma source de tainted data -->
        <ignoreFiles>
            <!-- Excluir legado onde não há injeção de entrada do usuário -->
		<file name="app/Support/Yaml.php" />
        </ignoreFiles>
    </taintAnalysis>
    <issueHandlers>
        <!--
            Métodos públicos de API (Entry, Site, Pages, ConfigurationService, etc.)
            são usados via templates Twig, eventos dinâmicos e API pública externa.
            O Psalm não "enxerga" esse uso — são falsos positivos.
        -->
        <PossiblyUnusedMethod errorLevel="info" />
        <PossiblyUnusedReturnValue errorLevel="info" />
        <PossiblyUnusedParam errorLevel="info" />
        <UnusedClass errorLevel="info" />
        <UnusedProperty errorLevel="info" />
        <PossiblyUnusedProperty errorLevel="info" />

        <!--
            Checks null/isset redundantes: o Psalm inferiu tipos mais precisos no v6
            e sinaliza ?? em campos tipados como string (não-nulo). O código é
            defensivo por design — esses checks serão revisados manualmente na Fase 3.
        -->
        <RedundantCondition errorLevel="info" />
        <TypeDoesNotContainType errorLevel="info" />

        <!-- Casts que o Psalm considera desnecessários -->
        <RedundantCast errorLevel="info" />

        <!-- Variáveis de iteração (foreach key/value) não utilizadas -->
        <UnusedForeachValue errorLevel="info" />
        <UnusedClosureParam errorLevel="info" />

        <!--
            Variáveis capturadas por efeito colateral: chaves de foreach com referências
            ($lang, $yearMonth em loops de ordenação) e retornos de métodos com efeito lateral
            ($menuLinks de getMenuLinks). Esses não são bugs.
        -->
        <UnusedVariable errorLevel="info" />
    </issueHandlers>

</psalm>
