MASTODON_DOMAIN=mastodon.test.meudominio.com
MISSKEY_DOMAIN=misskey.test.meudominio.com
PIXELFED_DOMAIN=pixelfed.test.meudominio.com
INDIEINABOX_DOMAIN=indieinabox.test.meudominio.com

# Portas locais expostas no host pelo Caddy central
HTTP_PORT=80
HTTPS_PORT=443

# Se true, o Caddy local não tentará gerar certificados SSL internamente.
# Ele rodará em HTTP puro confiando que o Cloudflare Tunnel (ou outro proxy)
# lidará com o HTTPS externo, passando X-Forwarded-Proto: https para os apps.
BEHIND_REVERSE_PROXY=true
